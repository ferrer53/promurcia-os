# ── Backend ─────────────────────────────────────────────────────
APP_ID=promurcia-os
APP_SECRET=local-dev-secret-change-in-production

# ── Database ───────────────────────────────────────────────────
# PostgreSQL requerido por db/schema.ts (drizzle-orm/pg-core).
# SQLite ya NO es compatible con este schema.
DATABASE_URL=postgresql://usuario:password@localhost:5432/promurcia

# ── OpenAI ──────────────────────────────────────────────────────
# Rellenar desde el dashboard de Render u otro secret manager.
OPENAI_API_KEY=sk-...

# ── Google Cloud (rellenar desde Render) ────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PROJECT_ID=

# ── Frontend (expuesto al navegador por Vite) ───────────────────
VITE_KIMI_AUTH_URL=
VITE_APP_ID=promurcia-os

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=
KIMI_OPEN_URL=

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=

# ── Seguridad ───────────────────────────────────────────────────
# Generar en producción con: openssl rand -base64 32
SESSION_SECRET=dev_secret_change_me_in_production

# ── Workers de Drive (DESHABILITADOS por defecto) ───────────────
DRIVE_WORKER_ENABLED=false
DRIVE_DISCOVERY_ENABLED=false
AUDIO_WORKER_ENABLED=false
